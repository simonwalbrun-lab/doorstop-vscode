{
  "name": "doorstop",
  "displayName": "Doorstop Requirements",
  "description": "VS Code integration for Doorstop requirements management system.",
  "publisher": "SimonWalbrun",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonwalbrun-lab/doorstop-vscode.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/.doorstop.yml",
    "workspaceContains:**/REQ*.yml",
    "workspaceContains:**/REQ*.md",
    "onLanguage:yaml",
    "onLanguage:markdown",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "doorstop",
          "title": "Doorstop Requirements",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "doorstop": [
        {
          "id": "doorstop.treeView",
          "name": "Hierarchy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
    {
      "command": "doorstop.openDiagram",
      "title": "Doorstop: Open Traceability Graph",
      "icon": "$(graph)"
    }
  ],
  "menus": {
    "view/title": [
      {
        "command": "doorstop.openDiagram",
        "when": "view == doorstopExplorer",
        "group": "navigation"
      }
    ]
  }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "js-yaml": "^5.4.1"
  }
}